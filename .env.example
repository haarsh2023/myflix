# Required in production (Vercel) to unlock your private Myflix library
MYFLIX_PASSCODE=change-me-to-a-strong-passcode

# Optional secret used to sign session cookies (falls back to passcode/blob token hash)
# MYFLIX_SESSION_SECRET=

# Auto-injected on Vercel when you connect a Vercel Blob store
# BLOB_READ_WRITE_TOKEN=
# Optional: "private" (default) or "public" to match your Vercel Blob store access mode
# BLOB_ACCESS=private
